# ─── MIRA Backend Environment ────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Core ────────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 50
SECRET_KEY=replace-with-a-long-random-string

DEBUG=False

# Comma-separated. For development: localhost,127.0.0.1
ALLOWED_HOSTS=mira.example.com

# ─── Database ────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://mira:mira@localhost:5432/mira

# ─── Redis ───────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of trusted frontend origins
CORS_ALLOWED_ORIGINS=https://mira.example.com

# ─── Email ───────────────────────────────────────────────────────────────────

# django.core.mail.backends.console.EmailBackend    (dev – prints to stdout)
# django.core.mail.backends.smtp.EmailBackend       (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MIRA GRC <noreply@mira.example.com>

# ─── OIDC / SSO (optional) ───────────────────────────────────────────────────
# Set OIDC_ENABLED=true to activate the SSO login button and backend provider.

OIDC_ENABLED=false
OIDC_PROVIDER_NAME=SSO
OIDC_SERVER_URL=https://your-idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ─── Logging ─────────────────────────────────────────────────────────────────

DJANGO_LOG_LEVEL=INFO
