# ─── Application ────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=true

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=conductor
POSTGRES_USER=conductor
POSTGRES_PASSWORD=conductor_pass
DATABASE_URL=postgresql+asyncpg://conductor:conductor_pass@postgres:5432/conductor

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Ollama ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# ─── ChromaDB ────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# ─── File Storage ────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# ─── Security ────────────────────────────────────────────────────
# Fernet key for connector credential encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-fernet-key

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── MIRA Integration (optional) ─────────────────────────────────
MIRA_API_URL=
MIRA_API_KEY=

# ─── Notifications (optional) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=conductor@example.com
